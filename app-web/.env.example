# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# --- Per-team Sheet/Drive config ---
# Every team configured in lib/teams.ts needs its own Sheet ID + Drive root
# folder ID env vars, named <TEAM_KEY>_SHEET_ID / <TEAM_KEY>_DRIVE_ROOT_FOLDER_ID.
# Nothing is shared across teams — a user's team (resolved from their email
# in lib/teams.ts) decides which of these gets used for every read/write.
#
# GM pilot (see lib/teams.ts — gorawit@tdfb.co, sirirat@tdfb.co, napat@tdfb.co):
# Sheet ID is found in the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS-ID>/edit
GM_SHEET_ID=your-gm-google-sheet-id
# Drive folder ID is found in the folder's URL: https://drive.google.com/drive/folders/<THIS-ID>
# (one subfolder per month is created inside it automatically)
GM_DRIVE_ROOT_FOLDER_ID=your-gm-google-drive-root-folder-id

# When onboarding a new team, add its own <TEAM>_SHEET_ID / <TEAM>_DRIVE_ROOT_FOLDER_ID
# pair here AND a matching entry in lib/teams.ts.

# --- OCR / AI receipt reading ---
# Gemini API key, obtained from https://aistudio.google.com/apikey — associated
# with the same Google Cloud project already used for OAuth above, no new
# project needed. Used by lib/ocr.ts (POST /api/ocr) to read receipt photos/PDFs
# and prefill the expense form.
GEMINI_API_KEY=your-gemini-api-key

# --- "แจ้งปัญหา/บัค" (report a bug) ---
# Slack Incoming Webhook for the "แจ้งปัญหา/บัค" report-a-bug button.
# Setup: api.slack.com/apps -> Create New App -> From scratch -> name it
# (e.g. "[BOT] แจ้งปัญหา Expense Tracking") -> pick the workspace ->
# Incoming Webhooks -> Activate -> Add New Webhook to Workspace -> choose
# a channel -> copy the Webhook URL below. Under "Display Information" set
# the app name/icon to how it should appear when posting.
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url
# Optional: Slack member ID to @-mention in every bug report (get it from
# that person's Slack profile -> "..." menu -> "Copy member ID").
SLACK_MENTION_USER_ID=
